{
  "name": "geny-connector",
  "version": "0.21.3",
  "description": "Geny VTuber desktop connector — a thin, always-on-top overlay that renders the live avatar from a running Geny server. The server stays the brain; this is the face.",
  "type": "module",
  "author": {
    "name": "Geny",
    "email": "noreply@hrletsgo.me"
  },
  "homepage": "https://github.com/CocoRoF/Geny",
  "repository": {
    "type": "git",
    "url": "https://github.com/CocoRoF/Geny.git"
  },
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@nut-tree-fork/nut-js": "^4.2.0",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.3.9",
    "picomatch": "^4.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
