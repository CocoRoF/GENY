# GAPT stack env — copy to deploy/gapt/.env on the host and fill in.
# `.env` is gitignored (secrets). Generate secrets with:  openssl rand -hex 32
#
# Used by:
#   docker compose -f gapt/compose/docker-compose.tunnel.yml \
#                  -f deploy/gapt/docker-compose.geny.yml \
#                  --env-file deploy/gapt/.env up -d --build

# ── Domains (path-mode previews: apex == preview host) ───────────────
# Geny fronts GAPT under its own host; previews are path-based
# (/preview/<slug>) so the preview domain equals the apex.
GAPT_DOMAIN=geny-x.hrletsgo.me
GAPT_PREVIEW_DOMAIN=geny-x.hrletsgo.me
ACME_EMAIL=admin@hrletsgo.me

# ── Secrets (openssl rand -hex 32) — KEEP CONSTANT once set ──────────
# Rotating GAPT_VAULT_MASTER_KEY orphans every stored secret.
GAPT_POSTGRES_PASSWORD=CHANGEME_postgres
GAPT_SESSION_SECRET=CHANGEME_session
GAPT_DAEMON_JWT_SECRET=CHANGEME_daemon
GAPT_VAULT_MASTER_KEY=CHANGEME_vault
GAPT_SHARE_LINK_SECRET=CHANGEME_share

# ── Single-admin (Geny's GaptClient logs in with these) ──────────────
GAPT_ADMIN_ID=admin
GAPT_ADMIN_PASSWORD=CHANGEME_admin

# ── SeaweedFS (must match gapt/compose/seaweed/s3.json) ──────────────
GAPT_SEAWEED_ACCESS_KEY=gapt-dev
GAPT_SEAWEED_SECRET_KEY=gapt-dev-secret

# ── Host wiring ──────────────────────────────────────────────────────
# `getent group docker | cut -d: -f3` on the host (so the non-root
# `gapt` user in the server container can read /var/run/docker.sock).
GAPT_DOCKER_GID=999
# Claude Code state dir on the host (identity-mounted into the server
# and every workspace sandbox). Owned by uid 1000.
GAPT_HOST_CLAUDE_DIR=/home/hrjang/.claude

# ── Workspace runtime ────────────────────────────────────────────────
GAPT_SANDBOX_RUNTIME=sysbox-runc
